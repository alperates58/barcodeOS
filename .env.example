APP_NAME=BarcodeOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=barcodeos
DB_USERNAME=barcodeos
DB_PASSWORD=barcodeos

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=barcodeos

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@barcodeos.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

BARCODE_STORAGE_DISK=local
BARCODE_DEFAULT_FORMAT=png
BARCODE_DEFAULT_DPI=300
BARCODE_TEMP_URL_TTL=15

API_RATE_LIMIT_PER_MINUTE=60
API_DEFAULT_MONTHLY_LIMIT=0

STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PADDLE_ENABLED=false
PADDLE_VENDOR_ID=
PADDLE_API_KEY=

PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

IYZICO_ENABLED=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

MANUAL_BANK_TRANSFER_ENABLED=false
MANUAL_BANK_TRANSFER_INSTRUCTIONS=

BARCODEOS_DEFAULT_FREE_PLAN=free

COOLIFY_ENABLED=false
COOLIFY_WEBHOOK_URL=
COOLIFY_WEBHOOK_SECRET=
COOLIFY_API_TOKEN=
COOLIFY_DEPLOY_BRANCH=main
COOLIFY_DEPLOY_METHOD=POST
COOLIFY_REQUEST_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"
